<?xml version="1.0" encoding="utf-8"?>
<!-- §12 Listing 7: usage history is privacy-sensitive — never cloud-backed up -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" />
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" />
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
